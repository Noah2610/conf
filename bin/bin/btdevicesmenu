#!/bin/bash
# btdevicesmenu
# Connect to a paired bluetooth device, selected from a rofi or dmenu list,
# using bluetoothctl.

set -e
set -o pipefail

# shellcheck source=./util.sh disable=SC2155
function _dl_util_sh {
    local UTIL_VERSION="v2.2.5"
    local dir="$( dirname "$1" )"
    [ -f "${dir}/util.sh" ] || bash "${dir}/download-util.sh" "$UTIL_VERSION" || exit 1
    source "${dir}/util.sh"
}; _dl_util_sh "$0"

function main {
    check "cut"
    check "notify-send"
    check "bluetoothctl"

    trap 'on_err "$?"' EXIT

    local devices=()
    mapfile -t devices < <( bluetoothctl devices Paired )

    # local device_names=()
    mapfile -t device_names < <(
        IFS=$'\n'
        <<<"${devices[*]}" cut -d' ' -f3-
    )

    # local device_ids=()
    mapfile -t device_ids < <(
        IFS=$'\n'
        <<<"${devices[*]}" cut -d' ' -f2
    )

    # local selected_idx=
    selected_idx="$( \
        IFS=$'\n'
        <<<"${device_names[*]}" \
        run_dmenu \
            -i -l 10 -fn JetBrainsMono:pixelsize=16 \
            -p "Select Bluetooth Device" \
            -format i
    )"

    URGENCY=low run_notify "Connecting to <b>${device_names[selected_idx]}</b>..."

    try_run bluetoothctl connect "${device_ids[selected_idx]}"

    run_notify \
        "Connected to Bluetooth device:" \
        "<b>${device_names[selected_idx]}</b>"
}

function on_err {
    local exit_code="$1"
    [ "$exit_code" -eq 0 ] && return

    if [ -n "$selected_idx" ] && [ ${#device_names[@]} -gt 0 ] && [ ${#device_ids[@]} -gt 0 ]; then
        local msg="Failed to connect to Bluetooth device \"${device_names[selected_idx]}\" with MAC \"${device_ids[selected_idx]}\""
        ( 1>&2 echo "[btdevicesmenu] $msg" )
        URGENCY=critical run_notify "$msg"
    else
        URGENCY=critical run_notify "An error occurred"
    fi
}

function run_notify {
    local urgency="$URGENCY"
    [ -z "$urgency" ] && urgency="normal"
    notify-send -u  "$urgency" "[btdevicesmenu]" "$( IFS=$'\n'; echo "$*" )"
}

function run_dmenu {
    if is_available rofi; then
        rofi -markup-rows -dmenu "$@"
    elif is_available dmenu; then
        dmenu "$@"
    else
        err "Expected either $(clr "${CLR_CODE[@]}")dmenu$(clrrs) or $(clr "${CLR_CODE[@]}")rofi$(clrrs) to be installed"
    fi
}

main "$@"
