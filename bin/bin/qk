#!/bin/bash

set -e

function err {
    ( 1>&2 echo "[Error] $1" )
    exit 1
}

function warn {
    ( 1>&2 echo "[Warning] $1" )
}

function contains {
    local e match="$1"
    shift
    for e; do [[ "$e" == "$match" ]] && return 0; done
    return 1
}

# quickeys wrapper
function qk_ {
    command -v quickeys &>/dev/null || err "quickeys not found"
    local -a keys
    mapfile -t keys < <( quickeys list --key-only )

    if contains "$1" "${keys[@]}"; then
        quickeys run "$1"
        return $?
    fi

    quickeys "$@"
}

function run_term {
    $QK_TERM --class "BORDERLESS-<XSMALL-XXSMALL>" -e bash -lc \
        "QK_TERM= ${HOME}/bin/qk $@"
}

function run_dmenu {
    command -v quickeys &>/dev/null || err "quickeys not found"
    quickeys list --key-only | rofi -dmenu | xargs quickeys run "$@"
}

function main {
    if [ -n "$QK_TERM" ]; then
        # Run quickeyes in new terminal
        run_term "$@"
    elif [ -n "$QK_DMENU" ]; then
        run_dmenu "$@"
    else
        # Run quickeyes
        qk_ "$@"
    fi
}

main "$@"
