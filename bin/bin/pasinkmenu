#!/bin/bash
# Switch default pulseaudio sink, seleted from dmenu.

set -e
set -o pipefail

# shellcheck source=./util.sh disable=SC2155
function _dl_util_sh {
    local UTIL_VERSION="v2.2.5"
    local dir="$( dirname "$1" )"
    [ -f "${dir}/util.sh" ] || bash "${dir}/download-util.sh" "$UTIL_VERSION" || exit 1
    source "${dir}/util.sh"
}; _dl_util_sh "$0"

check "pactl"
check "jq"

function main {
    local default_sink=
    default_sink="$( pactl get-default-sink )"

    local dmenu_item_prefix="          "

    local sink_json=
    sink_json="$( pactl --format json list sinks | jq -c '
        map(
            select(
                (.ports | any(
                    .availability == "available" or
                    .availability == "availability unknown"
                )) or (.name == "gnome_network_displays")
            ) | {
                nick: .properties."node.nick",
                name,
                item,
                description,
                priority: (.properties."priority.driver" // 0) | tonumber,
                default: (.name == "'${default_sink}'")
            }
        ) | map({
                item: (
                    if .default then "<span weight=\"bold\">[Current] </span>" else "" end
                    + if .nick then
                        .nick + " <span color=\"#888888\"><small>" + .description + "</small></span>"
                    else .description end
                ),
                nick, name, description, priority, default
        }) | sort_by(.priority) | reverse
    ')"

    local selected_sink=
    selected_sink="$( <<<"$sink_json" jq -r '.[].item' \
        | run_dmenu -i -l 10 -fn JetBrainsMono:pixelsize=16 -p "Audio Output" )"
    selected_sink="${selected_sink//\"/\\\"}"

    [ -z "$selected_sink" ] && err "No sink selected"

    local selected_sink_name=
    selected_sink_name="$( <<<"$sink_json" jq -r '
        .[] | select(.item == "'"${selected_sink}"'") | .name
    ' )"

    [ -z "$selected_sink_name" ] && err "No sink found for selection"

    local selected_sink_nick=
    selected_sink_nick="$( <<<"$sink_json" jq -r '
        .[] | select(.item == "'"${selected_sink}"'") | (.nick // .description)
    ' )"

    try_run pactl set-default-sink "$selected_sink_name"

    notify-send "[pasinkmenu]" "Set audio sink to:\n<b>${selected_sink_nick}</b>"
}

function run_dmenu {
    if is_available rofi; then
        rofi -markup-rows -dmenu "$@"
    elif is_available dmenu; then
        dmenu "$@"
    else
        err "Expected either $(clr "${CLR_CODE[@]}")dmenu$(clrrs) or $(clr "${CLR_CODE[@]}")rofi$(clrrs) to be installed"
    fi
}

main "$@"
